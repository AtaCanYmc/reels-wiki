meta {
  name: Generate Digest Dry Run
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/digest
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "days": 7,
    "dry_run": true
  }
}

assert {
  res.status: eq 200
  res.body.dry_run: eq true
  res.body.notes_count: isNumber
}
