meta {
  name: Ingest TikTok Video
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/ingest
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "url": "https://www.tiktok.com/@kodkatman/video/7684682826159049991",
    "source": "bruno"
  }
}

assert {
  res.status: eq 200
  res.body.ok: eq true
  res.body.shortcode: eq tt_7684682826159049991
}
