meta {
  name: Ingest YouTube Short
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/ingest
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "url": "https://www.youtube.com/shorts/VpW4T7e34EI",
    "source": "bruno"
  }
}

assert {
  res.status: eq 200
  res.body.ok: eq true
  res.body.shortcode: eq yt_VpW4T7e34EI
}
