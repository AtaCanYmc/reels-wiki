# Copy to .env and fill in real credentials. Never commit .env.

# Required for Groq Whisper transcription and/or Groq LLM synthesis
GROQ_API_KEY=your_groq_api_key

# Required for Gemini Vision OCR fallback and/or Gemini LLM synthesis
GEMINI_API_KEY=your_gemini_api_key

# Optional: Telegram share capture bot (reels-sync telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_CHAT_ID=123456789

# Optional: runtime path overrides
# REELS_WIKI_CONFIG=./config.yaml
# REELS_WIKI_VAULT=~/Documents/ObsidianVault
